<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1>Social feed</h1>
    <%= link_to "Create post", new_post_path, class: "btn btn-primary" %>
  </div>
  <div class="btn-group mb-4" role="group" aria-label="Choose feed">
    <%= link_to "All visible posts", posts_path, class: "btn #{@feed == 'all' ? 'btn-primary' : 'btn-outline-primary'}" %>
    <%= link_to "My posts", posts_path(feed: :mine), class: "btn #{@feed == 'mine' ? 'btn-primary' : 'btn-outline-primary'}" %>
  </div>
  <% if @posts.empty? %>
    <p class="text-muted">No posts to show yet.</p>
  <% end %>
  <% @posts.each do |post| %>
    <article class="card mb-4">
      <div class="card-header d-flex justify-content-between">
        <strong><%= post.user.email %></strong>
        <span class="badge bg-secondary"><%= post.tags.humanize %></span>
      </div>
      <% if post.image? %>
        <%= image_tag post.image.url, class: "card-img-top", alt: post.name, style: "max-height: 360px; object-fit: contain;" %>
      <% end %>
      <div class="card-body">
        <h3 class="h5"><%= post.name %></h3>
        <p><%= post.content %></p>
        <p class="text-muted small"><%= time_ago_in_words(post.created_at) %> ago</p>
        <%= link_to "Comments", post_comments_path(post), class: "btn btn-outline-primary btn-sm" %>
        <% if post.user_id == current_user.id %>
          <%= link_to "Edit", edit_post_path(post), class: "btn btn-outline-secondary btn-sm" %>
          <%= button_to "Delete", post_path(post), method: :delete, class: "btn btn-outline-danger btn-sm d-inline-block" %>
        <% end %>
      </div>
    </article>
  <% end %>
</div>
