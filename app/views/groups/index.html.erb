<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center">
    <h2>Groups</h2>
    <%= link_to "Create group", new_group_path, class: "btn btn-primary" %>
  </div>
  <% @groups.each do |group| %>
    <div class="card my-3">
      <% if group.banner? %>
        <%= image_tag group.banner.url, class: "card-img-top", alt: group.name, style: "max-height: 280px; object-fit: cover;" %>
      <% end %>
      <div class="card-body">
        <h3 class="h5"><%= group.name %></h3>
        <p><%= group.description %></p>
        <% if group.owner_id == current_user.id %>
          <%= link_to "Edit", edit_group_path(group), class: "btn btn-outline-secondary btn-sm" %>
          <%= button_to "Delete", group_path(group), method: :delete, class: "btn btn-outline-danger btn-sm d-inline-block" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
