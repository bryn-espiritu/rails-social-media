<div class="container my-4">
  <h2>Comments</h2>
  <%= link_to "Add comment", new_post_comment_path(@post), class: "btn btn-primary mb-3" %>
  <% @comments.each do |comment| %>
    <div class="card mb-2"><div class="card-body">
      <strong><%= comment.user.email %></strong>
      <p><%= comment.content %></p>
      <% if comment.user_id == current_user.id %>
        <%= link_to "Edit", edit_post_comment_path(@post, comment), class: "btn btn-sm btn-outline-secondary" %>
        <%= button_to "Delete", post_comment_path(@post, comment), method: :delete, class: "btn btn-sm btn-outline-danger d-inline-block" %>
      <% end %>
    </div></div>
  <% end %>
</div>
