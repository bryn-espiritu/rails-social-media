<div class="container my-4">
  <h2>Explore people</h2>
  <% @strangers.each do |person| %>
    <div class="card mb-2"><div class="card-body d-flex justify-content-between align-items-center">
      <span><%= person.email %></span>
      <%= button_to "Add Friend", friend_requests_path(friend_id: person.id), method: :post, class: "btn btn-dark" %>
    </div></div>
  <% end %>
  <h2 class="mt-4">Incoming requests</h2>
  <% @incoming.each do |request| %>
    <div class="card mb-2"><div class="card-body d-flex justify-content-between align-items-center">
      <span><%= request.user.email %></span>
      <div>
        <%= button_to "Accept", friend_request_path(request), method: :patch, class: "btn btn-outline-primary d-inline-block" %>
        <%= button_to "Decline", friend_request_path(request), method: :delete, class: "btn btn-outline-danger d-inline-block" %>
      </div>
    </div></div>
  <% end %>
  <h2 class="mt-4">Sent requests</h2>
  <% @outgoing.each do |request| %>
    <div class="card mb-2"><div class="card-body d-flex justify-content-between align-items-center">
      <span><%= request.friend.email %></span>
      <%= button_to "Cancel", friend_request_path(request), method: :delete, class: "btn btn-outline-danger" %>
    </div></div>
  <% end %>
</div>
